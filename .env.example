# LiveKit Cloud (or self-hosted LiveKit) connection details.
# Keep LIVEKIT_API_SECRET server-side; only NEXT_PUBLIC_LIVEKIT_URL is exposed to clients.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
# The HTTPS URL that the iPhone should use to reach this app. For local testing,
# set this to your current cloudflared/ngrok URL, not localhost.
NEXT_PUBLIC_PUBLIC_APP_URL=https://your-public-tunnel.example.com
